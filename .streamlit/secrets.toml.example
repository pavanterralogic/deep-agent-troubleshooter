# Paste this (with real values) into: Streamlit Cloud -> your app -> Settings -> Secrets
LLM_PROVIDER = "gemini"
LLM_MODEL = "gemini-3.5-flash-lite"
GOOGLE_API_KEY = "your_google_api_key_here"
LLM_REQUESTS_PER_MINUTE = "8"
