# Streamlit secrets (Streamlit Cloud -> your app -> Settings -> Secrets, or .streamlit/secrets.toml)
# Default: a local / self-hosted Ollama server. Streamlit Community Cloud cannot run Ollama itself,
# so OLLAMA_BASE_URL must point to an Ollama server the app can reach.
LLM_PROVIDER = "ollama"
LLM_MODEL = "qwen3:8b"
OLLAMA_BASE_URL = "http://localhost:11434"

# Alternative for Streamlit Community Cloud (cloud model, free tier):
# LLM_PROVIDER = "gemini"
# LLM_MODEL = "gemini-3.5-flash-lite"
# GOOGLE_API_KEY = "your_google_api_key_here"
# LLM_REQUESTS_PER_MINUTE = "8"
