# Which LLM to use: gemini (recommended, free tier) or groq
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Calls per minute; keep below your free-tier limit
LLM_REQUESTS_PER_MINUTE=8

# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL for groq: openai/gpt-oss-120b, qwen/qwen3.8-27b

# Optional PAID backup: used automatically only when the main model fails
# (e.g. free daily quota used up). Leave empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
