# Which LLM to use: ollama (default, local, free, no key), gemini or groq
LLM_PROVIDER=ollama
# Pull it first:  ollama pull qwen3:8b
# Other models with tool calling: qwen2.5:7b, llama3.1:8b, qwen3:14b (needs more RAM)
LLM_MODEL=qwen3:8b

# ---- Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens. The agent prompts need >= 16k; lower it only if you run out of RAM.
OLLAMA_NUM_CTX=16384
# true = let qwen3-style models "think" first (better answers, much slower on CPU)
OLLAMA_THINKING=false

# ---- Cloud providers (only if LLM_PROVIDER=gemini or groq)
# GOOGLE_API_KEY=your_google_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# Calls per minute for cloud free tiers
LLM_REQUESTS_PER_MINUTE=8

# ---- Optional cloud backup when the main model fails.
# Off by default with Ollama so nothing leaves your machine; set ENABLE_CLOUD_BACKUP=true to use it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
ENABLE_CLOUD_BACKUP=false
